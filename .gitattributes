# 统一换行符设置 - 确保跨平台兼容性
# 所有文本文件使用 LF 换行符

# 源代码文件
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.less text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.bat text eol=lf
*.cmd text eol=lf

# 配置文件
*.config.js text eol=lf
*.config.ts text eol=lf
.eslintrc.* text eol=lf
.prettierrc* text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.npmrc text eol=lf

# 二进制文件 - 不进行换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.ico binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.zip binary
*.tar binary
*.gz binary
*.rar binary
*.7z binary
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary

# 特殊文件
*.suika binary
*.GAssetForgeEditor binary
