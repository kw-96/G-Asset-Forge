{
  "name": "g-asset-forge",
  "version": "0.0.1",
  "main": "index.js",
  "author": "xigua",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "run-p common:dev icons:dev components:dev geo:dev core:dev app:dev",
    "dev-m": "run-p common:dev icons:dev components:dev geo:dev core:dev app-m:dev",
    "build": "pnpm -r --filter !@g-asset-forge/backend --filter !@g-asset-forge/workbench exec pnpm run build",
    "app:dev": "pnpm --filter @g-asset-forge/g-asset-forge dev",
    "app-m:dev": "pnpm --filter @g-asset-forge/g-asset-forge-multiplayer dev",
    "app:build": "pnpm --filter @g-asset-forge/g-asset-forge build",
    "storybook": "pnpm --filter @g-asset-forge/components storybook",
    "components:build": "pnpm --filter @g-asset-forge/components build",
    "common:dev": "pnpm -F @g-asset-forge/common dev",
    "geo:dev": "pnpm -F @g-asset-forge/geo dev",
    "core:dev": "pnpm -F @g-asset-forge/core dev",
    "icons:dev": "pnpm -F @g-asset-forge/icons dev",
    "components:dev": "pnpm -F @g-asset-forge/components dev",
    "test": "jest --testPathIgnorePatterns='apps/backend'",
    "prepare": "husky install",
    "eslint:check": "eslint packages",
    "docs:dev": "pnpm -F @g-asset-forge/docs docs:dev",
    "workbench:dev": "pnpm -F @g-asset-forge/workbench run dev",
    "backend:dev": "pnpm -F @g-asset-forge/backend run dev",
    "electron:dev": "concurrently \"pnpm run app:dev\" \"wait-on http://localhost:6167 && cross-env NODE_ENV=development node_modules/electron/cli.js electron/main.js\"",
    "electron:build": "pnpm run app:build && electron-builder",
    "electron:pack": "pnpm run app:build && electron-builder --dir",
    "electron:dist": "pnpm run app:build && electron-builder"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.6.1",
    "@commitlint/config-conventional": "^17.6.1",
    "@jgoz/esbuild-plugin-typecheck": "^3.1.0",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.17.17",
    "esbuild-sass-plugin": "^2.9.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^13.2.1",
    "minimist": "^1.2.8",
    "npm-run-all": "^4.1.5",
    "picocolors": "^1.0.0",
    "prettier": "2.8.7",
    "ts-jest": "^29.1.2",
    "typescript": "^5.2.2",
    "wait-on": "^8.0.4",
    "yargs": "^18.0.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 80,
    "tabWidth": 2,
    "semi": true,
    "bracketSpacing": true
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "node": ">=18.12.0"
  }
}
